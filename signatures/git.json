{
  "comment": "Per-tool git history signatures. Patterns are case-insensitive JS regexes. 'trailers' and 'message' run against the full commit message; 'authorName'/'authorEmail' against commit author fields. Every match is Tier A evidence.",
  "tools": [
    {
      "id": "claude-code",
      "name": "Claude Code (Anthropic)",
      "trailers": ["Co-Authored-By:\\s*Claude\\b"],
      "message": ["Generated with \\[?Claude Code\\]?", "🤖 Generated with Claude"],
      "authorName": ["^claude(\\[bot\\])?$"],
      "authorEmail": ["noreply@anthropic\\.com", "claude\\[bot\\]@users\\.noreply\\.github\\.com"]
    },
    {
      "id": "github-copilot",
      "name": "GitHub Copilot",
